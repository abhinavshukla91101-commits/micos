// MiniOS boot splash — plain, fast, no heavy animation.

Window.SetBackgroundTopColor(0.10, 0.10, 0.10);
Window.SetBackgroundBottomColor(0.05, 0.05, 0.05);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 0);

spinner_frames = 24;
for (i = 0; i < spinner_frames; i++) {
  spinner.image[i] = Image("spinner/frame" + i + ".png");
}
spinner.sprite = Sprite();
spinner.sprite.SetPosition(
  Window.GetWidth() / 2 - 24,
  logo.y + logo.image.GetHeight() + 30,
  0
);

status.text = "";
status.sprite = Sprite();

fun refresh_callback() {
  spinner.frame = (spinner.frame + 1) % spinner_frames;
  spinner.sprite.SetImage(spinner.image[spinner.frame]);
}
Plymouth.SetRefreshFunction(refresh_callback);

fun display_normal_callback() {
  logo.sprite.SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun message_callback(text) {
  status.text = text;
}
Plymouth.SetMessageFunction(message_callback);

fun quit_callback() {
  logo.sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);
